{
  "manifest_version": 3,
  "name": "Selection Collector",
  "version": "0.1.0",
  "description": "Shows an empty translation box and saves highlighted text.",
  "permissions": ["storage","tabs"],
  "host_permissions":[
    "https://ws.detectlanguage.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.datamuse.com/*"
  ],
  "action": {
    "default_title": "View saved phrases"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
